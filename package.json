{
  "name": "arbol-implicaciones",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Editor local de mapas mentales basado en Mind Elixir",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:app": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-mono": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "dompurify": "^3.4.18",
    "jspdf": "^4.2.1",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "mind-elixir": "6.0.3",
    "opentype.js": "^2.0.0",
    "svg2pdf.js": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.5.2",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.2.0"
  }
}
